+  const first = pending();
+  const fresh = pending();
+  send.mockReturnValueOnce(first.promise).mockReturnValueOnce(fresh.promise);
+  const { result, unmount } = renderHook(useSpreadsheet, {
+    wrapper: SpreadsheetProvider,
