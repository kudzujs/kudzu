+
+it('does not clear a replacement read when an old read rejects', async () => {
+  const old = pending();
+  const fresh = pending();
+  send.mockReturnValueOnce(old.promise).mockReturnValueOnce(fresh.promise);
+  const { result, unmount } = renderHook(useSpreadsheet, {
+    wrapper: SpreadsheetProvider,
