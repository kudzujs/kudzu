diff --git a/packages/loot-core/src/platform/client/connection/bfcache.test.ts b/packages/loot-core/src/platform/client/connection/bfcache.test.ts
new file mode 100644
index 0000000..6f246e6
--- /dev/null
+++ b/packages/loot-core/src/platform/client/connection/bfcache.test.ts
@@ -0,0 +1,106 @@
+import { afterEach, expect, it, vi } from 'vitest';
+
+import type * as Connection from './index';
+
+vi.mock('#platform/client/undo', () => ({
+  snapshot: () => 'undo',
+  gc: vi.fn(),
+}));
+vi.mock('#platform/exceptions', () => ({
+  captureException: vi.fn(),
+  captureBreadcrumb: vi.fn(),
+}));
+
+const ports: MessagePort[] = [];
+afterEach(() => {
+  for (const port of ports.splice(0)) port.close();
+  vi.unstubAllGlobals();
+  vi.resetModules();
+});
+
+async function connection() {
+  const window = new EventTarget();
+  vi.stubGlobal('window', window);
+  const { port1, port2 } = new MessageChannel();
+  ports.push(port1, port2);
+  const socket = Object.assign(port1, { postMessage: vi.fn() });
+  const { init, send } = await vi.importActual<typeof Connection>('./index');
+  const opened = init(socket);
+  const receive = (data: unknown) =>
+    socket.onmessage?.call(socket, new MessageEvent('message', { data }));
+  const lifecycle = (type: string, persisted = true) =>
+    window.dispatchEvent(Object.assign(new Event(type), { persisted }));
+  return { socket, send, receive, lifecycle, opened };
+}
+
+it('settles suspended requests once, ignores late replies and never replays writes', async () => {
+  const { socket, send, receive, lifecycle, opened } = await connection();
+  receive({ type: 'connect' });
+  await opened;
+  const outcome = vi.fn();
+  const request = send('account-create', {
+    name: 'Checking',
+    balance: 1000,
+    offBudget: false,
+  }).then(outcome, outcome);
+  const message = socket.postMessage.mock.calls.at(-1)?.[0];
+  lifecycle('pagehide');
+  await Promise.resolve();
+  expect(outcome).not.toHaveBeenCalled();
+  lifecycle('pageshow');
+  await request;
+  expect(outcome).toHaveBeenCalledExactlyOnceWith(
+    expect.objectContaining({ name: 'RequestOutcomeUnknownError' }),
+  );
+  receive({ type: 'reply', id: message.id, result: 'committed-id' });
+  lifecycle('pageshow');
+  expect(outcome).toHaveBeenCalledTimes(1);
+  expect(
+    socket.postMessage.mock.calls.filter(
+      ([msg]) => msg.name === 'account-create',
+    ),
+  ).toHaveLength(1);
+  const fresh = send('accounts-get');
+  receive({
+    type: 'reply',
+    id: socket.postMessage.mock.calls.at(-1)?.[0].id,
+    result: [],
+  });
+  await expect(fresh).resolves.toEqual([]);
+});
+
+it('preserves completed requests and ignores non-persisted lifecycle events', async () => {
+  const { socket, send, receive, lifecycle, opened } = await connection();
+  receive({ type: 'connect' });
+  await opened;
+  const completed = send('accounts-get');
+  receive({
+    type: 'reply',
+    id: socket.postMessage.mock.calls.at(-1)?.[0].id,
+    result: [],
+  });
+  lifecycle('pagehide');
+  lifecycle('pageshow');
+  await expect(completed).resolves.toEqual([]);
+  const pending = send('accounts-get');
+  const id = socket.postMessage.mock.calls.at(-1)?.[0].id;
+  lifecycle('pagehide', false);
+  lifecycle('pageshow', false);
+  receive({ type: 'reply', id, result: ['fresh'] });
+  await expect(pending).resolves.toEqual(['fresh']);
+});
+
+it('does not send suspended queued requests and identifies them as unexecuted', async () => {
+  const { socket, send, receive, lifecycle, opened } = await connection();
+  const pending = send('accounts-get').catch(error => error);
+  lifecycle('pagehide');
+  lifecycle('pageshow');
+  expect(await pending).toMatchObject({ name: 'RequestNotSentError' });
+  receive({ type: 'connect' });
+  await opened;
+  expect(
+    socket.postMessage.mock.calls.filter(
+      ([msg]) => msg.name === 'accounts-get',
+    ),
+  ).toHaveLength(0);
+});
