@@ -0,0 +1,118 @@
+import type { Query } from '@actual-app/core/shared/query';
+import { renderHook, waitFor } from '@testing-library/react';
+import { afterEach, beforeEach, expect, it, vi } from 'vitest';
+
+import { SpreadsheetProvider, useSpreadsheet } from './useSpreadsheet';
+
+const { send, dispatch, translate } = vi.hoisted(() => ({
+  send: vi.fn(),
+  dispatch: vi.fn(),
+  translate: (message: string) => message,
+}));
+vi.mock('@actual-app/core/platform/client/connection', () => ({
+  send,
+  listen: () => () => {},
+}));
+vi.mock('#redux', () => ({ useDispatch: () => dispatch }));
+vi.mock('react-i18next', () => ({ useTranslation: () => ({ t: translate }) }));
+vi.mock('#notifications/notificationsSlice', () => ({
+  addNotification: (payload: unknown) => ({ type: 'notification', payload }),
+}));
+
+beforeEach(() => vi.clearAllMocks());
+afterEach(() => vi.restoreAllMocks());
+
+function pending() {
+  let resolve!: (value: { name: string; value: number }) => void;
+  let reject!: (error: Error) => void;
+  const promise = new Promise<{ name: string; value: number }>((yes, no) => {
+    resolve = yes;
+    reject = no;
+  });
+  return { promise, resolve, reject };
+}
+
+it('reports query and shared read failures without replay or unhandled rejection', async () => {
+  const query = pending();
+  const read = pending();
+  send.mockImplementation(name =>
+    name === 'create-query' ? query.promise : read.promise,
+  );
+  const { result, unmount } = renderHook(useSpreadsheet, {
+    wrapper: SpreadsheetProvider,
+  });
+  const callback = vi.fn();
+  const binding = {
+    name: 'balance',
+    query: { serialize: () => ({}) } as Query,
+  };
+  const first = result.current.bind('__global', binding, callback);
+  const second = result.current.bind('__global', 'balance', callback);
+  const error = new Error(
+    'The backend leader changed. Reload and check your data.',
+  );
+  query.reject(error);
+  read.reject(error);
+  await waitFor(() => expect(dispatch).toHaveBeenCalledTimes(3));
+  expect(callback).not.toHaveBeenCalled();
+  expect(send).toHaveBeenCalledTimes(2);
+  for (const [action] of dispatch.mock.calls) {
+    expect(action.payload.notification).toMatchObject({
+      id: 'spreadsheet-read-error',
+      type: 'error',
+      sticky: true,
+      pre: error.message,
+    });
+    expect(action.payload.notification.message).toContain('Reload');
+  }
+  first();
+  second();
+  unmount();
+});
+
+it('clears a failed read so a later explicit binding can read fresh data', async () => {
+  const first = pending();
+  const fresh = pending();
+  send.mockReturnValueOnce(first.promise).mockReturnValueOnce(fresh.promise);
+  const { result, unmount } = renderHook(useSpreadsheet, {
+    wrapper: SpreadsheetProvider,
+  });
+  const oldCallback = vi.fn();
+  const callback = vi.fn();
+  result.current.bind('__global', 'balance', oldCallback);
+  first.reject(new Error('read failed'));
+  await waitFor(() => expect(dispatch).toHaveBeenCalled());
+  result.current.bind('__global', 'balance', callback);
+  fresh.resolve({ name: '__global!balance', value: 1000 });
+  await waitFor(() =>
+    expect(callback).toHaveBeenCalledWith({
+      name: '__global!balance',
+      value: 1000,
+    }),
+  );
+  expect(oldCallback).not.toHaveBeenCalled();
+  expect(send).toHaveBeenCalledTimes(2);
+  unmount();
+});
+
+it('does not clear a replacement read when an old read rejects', async () => {
+  const old = pending();
+  const fresh = pending();
+  send.mockReturnValueOnce(old.promise).mockReturnValueOnce(fresh.promise);
+  const { result, unmount } = renderHook(useSpreadsheet, {
+    wrapper: SpreadsheetProvider,
+  });
+  const release = result.current.bind('__global', 'balance', vi.fn());
+  release();
+  const callback = vi.fn();
+  result.current.bind('__global', 'balance', callback);
+  old.reject(new Error('old read failed'));
+  await waitFor(() => expect(dispatch).toHaveBeenCalled());
+  const other = vi.fn();
+  result.current.bind('__global', 'balance', other);
+  fresh.resolve({ name: '__global!balance', value: 1000 });
+  await waitFor(() => expect(other).toHaveBeenCalledTimes(1));
+  expect(callback).toHaveBeenCalledTimes(1);
+  expect(send).toHaveBeenCalledTimes(2);
+  unmount();
+});
